DB_URL="mysql://coclaw:coclaw_db_2026@127.0.0.1:3306/coclaw"
# 无需 SHADOW_DB_URL：migrate dev 的 shadow 库由 Prisma 自动创建/删除（详见 README「迁移与 shadow 库」）
# BINDING_CODE_EXPIRE_MINUTES="30"

# 本地开发 TURN 配置（与 compose.dev.yaml 中 coturn 的 static-auth-secret 一致）
TURN_SECRET=dev-secret-placeholder
APP_DOMAIN=localhost

# CORS 允许的 origin 列表（逗号分隔）
# 生产环境必须设置（如 https://im.coclaw.net）
# 开发环境可不设置，localhost 自动放行
# capacitor://localhost 已内置，无需额外添加
# ALLOWED_ORIGINS="https://im.coclaw.net"
