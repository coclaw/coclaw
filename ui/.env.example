# CoClaw 桌面端（Electron）/ iOS 构建期 签名 / 公证 环境变量。
#
# 这些都是“构建期”变量，不是运行时配置。electron-builder 不会自动加载 .env，
# 需在执行构建前自行 export（或在 CI 中注入）。全部缺失时构建仍成功，但产物
# 未签名 / 未公证，仅供本地调试；正式分发必须配齐对应平台的凭据。
# electron-builder 内置公证（mac.notarize: true）会自动读取下列 APPLE_* 变量，
# 缺失即静默跳过。参见 electron-builder.yaml、docs/ios-build-release.md。

# ===== macOS 签名（Developer ID Application 证书）=====
# CSC_LINK 可为 .p12 文件路径，或其 base64 字符串
CSC_LINK=
CSC_KEY_PASSWORD=

# ===== macOS 公证（二选一）=====
# 方式 A：Apple ID + App 专用密码
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# 方式 B：App Store Connect API Key（.p8）
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=

# ===== Windows 签名（OV / EV 证书）=====
# 复用 electron-builder 自动识别的 CSC_*（指向 .pfx/.p12）；
# 若需与 mac 区分，可用 WIN_CSC_LINK / WIN_CSC_KEY_PASSWORD
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=

# ===== iOS 归档签名 =====
# Apple Developer 团队 ID，供 Xcode 自动签名归档真机包：
#   xcodebuild ... DEVELOPMENT_TEAM=$IOS_DEVELOPMENT_TEAM -allowProvisioningUpdates
# 仅模拟器构建（CODE_SIGNING_ALLOWED=NO）时不需要。
IOS_DEVELOPMENT_TEAM=
