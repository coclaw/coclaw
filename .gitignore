# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/

# Test & coverage
coverage/
test-results/

# Environment & secrets
.env
.env.*
!.env.example
!*.env.example
!.env.*.example
.npmrc
.coclaw-tunnel.json

# SSL private keys & certificates (deploy on server only, never commit)
*.key
*.crt
*.pem

# Logs & temp
*.log
tmp/

# Package artifacts
*.tgz

# OS
.DS_Store
Thumbs.db

# IDE & editors
.vscode/
.idea/

# AI tool configs — keep skills, ignore personal settings
# .claude is a symlink to .agents, git won't traverse into it
**/.agents/settings.json
**/.agents/settings.local.json
# Claude Code runtime lock (scheduled tasks)
**/scheduled_tasks.lock
# Codex 工具在各 workspace 创建的 .codex 文件/个人目录均不入库；
# 根 .codex/config.toml（MCP 配置）此前已 tracked，本规则只影响后续新增内容。
.codex

# Local symlinks (developer-specific)
openclaw-repo
ref-projects

# admin UI
/admin/

# Prisma generated output (rebuild via `prisma generate`)
server/src/generated/
docs/product/
docs/study/
docs/plans/
