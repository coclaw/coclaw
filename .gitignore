# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/

# Test & coverage
coverage/
test-results/

# Environment & secrets
.env
.env.*
!.env.example
!*.env.example
!.env.*.example
.npmrc
.coclaw-tunnel.json

# SSL private keys & certificates (deploy on server only, never commit)
*.key
*.crt
*.pem

# Logs & temp
*.log
tmp/

# Package artifacts
*.tgz

# OS
.DS_Store
Thumbs.db

# IDE & editors
.vscode/
.idea/

# AI tool configs — keep skills, ignore personal settings
# .claude is a symlink to .agents, git won't traverse into it
**/.agents/settings.json
**/.agents/settings.local.json
# git worktrees live here (nested checkouts, transient) — never track them
/.agents/worktrees/
# Claude Code runtime lock (scheduled tasks)
**/scheduled_tasks.lock
# codex-rescue subagent 会在各 workspace 留下空 .codex 标记文件，不入库；
# 但 .codex/ 目录（含根目录的 MCP 配置目录）任何位置都保留 tracked。
.codex
!.codex/

# Local symlinks (developer-specific)
openclaw-repo
ref-projects

# admin UI
/admin/

# Prisma generated output (rebuild via `prisma generate`)
server/src/generated/
docs/product/
docs/study/
docs/plans/
docs/tasks/
docs/upstream-issues/
/.teamwork/
